{
  "comments": {
    "lineComment": ";;"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"],
    ["**", "**"],
    ["*", "*"]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"],
    ["**", "**"],
    ["*", "*"]
  ],
  "wordPattern": "[^\\s()\"`]+",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\([^)]*$",
    "decreaseIndentPattern": "^\\s*\\)"
  },
  "folding": {
    "offSide": true
  }
}
