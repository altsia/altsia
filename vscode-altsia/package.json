{
  "name": "altsia-vscode",
  "displayName": "Altsia",
  "description": "Altsia language support for VS Code",
  "version": "0.2.0",
  "publisher": "altsia",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "altsia",
    "markup",
    "document",
    "highlight"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/altsia/altsia.git",
    "directory": "vscode-altsia"
  },
  "homepage": "https://github.com/altsia/altsia",
  "contributes": {
    "languages": [
      {
        "id": "altsia",
        "aliases": [
          "Altsia",
          "altsia"
        ],
        "extensions": [
          ".alt",
          ".altsia",
          ".sia"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "altsia",
        "scopeName": "source.altsia",
        "path": "./syntaxes/altsia.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "altsia",
        "path": "./snippets/altsia.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "altsia.preview",
        "title": "Altsia: Open Preview",
        "category": "Altsia"
      },
      {
        "command": "altsia.preview.refresh",
        "title": "Altsia: Refresh Preview",
        "category": "Altsia"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "altsia.preview",
          "when": "resourceLangId == altsia",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "altsia.preview",
          "when": "resourceLangId == altsia",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "altsia.preview",
          "when": "resourceLangId == altsia"
        },
        {
          "command": "altsia.preview.refresh",
          "when": "resourceLangId == altsia"
        }
      ]
    },
    "configuration": {
      "title": "Altsia",
      "properties": {
        "altsia.preview.command": {
          "type": "string",
          "default": "alt",
          "description": "Command or absolute path used to run the Altsia CLI."
        },
        "altsia.preview.commandArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments inserted before `preview <entry.alt>` when running the Altsia CLI."
        },
        "altsia.preview.autoSaveBeforeRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Save dirty Altsia documents before refreshing the preview."
        }
      }
    }
  },
  "scripts": {
    "pkg": "npx @vscode/vsce package"
  }
}
