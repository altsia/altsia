{
  "name": "altsia-vscode",
  "displayName": "Altsia",
  "description": "Altsia language support for VS Code",
  "version": "0.2.0",
  "publisher": "altsia",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "altsia",
    "markup",
    "document",
    "highlight"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/altsia/altsia.git",
    "directory": "vscode-altsia"
  },
  "homepage": "https://github.com/altsia/altsia",
  "contributes": {
    "languages": [
      {
        "id": "altsia",
        "aliases": [
          "Altsia",
          "altsia"
        ],
        "extensions": [
          ".alt",
          ".altsia"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "altsia",
        "scopeName": "source.altsia",
        "path": "./syntaxes/altsia.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "altsia",
        "path": "./snippets/altsia.code-snippets"
      }
    ]
  },
  "scripts": {
    "pkg": "npx @vscode/vsce package"
  }
}
